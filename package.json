{
  "name": "claude-in-codex",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": { "node": ">=22.19.0 <23.0.0 || >=24.0.0 <25.0.0" },
  "workspaces": ["packages/*", "packages/adapters/*"],
  "prettier": {
    "arrowParens": "always",
    "endOfLine": "lf",
    "printWidth": 100,
    "proseWrap": "preserve",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "scripts": {
    "bootstrap": "node tools/fork/bootstrap.mjs",
    "build:typescript": "tsc -b && npm run build:plugins",
    "build:plugins": "node scripts/release/harness-plugins.mjs --output packages/host-runtime/dist/plugins",
    "build:rust": "cargo build --locked --package codexhost-launcher --package codexhost-platform --package codexhost-shim",
    "typecheck": "tsc -b --pretty false",
    "test:typescript": "npm run build:typescript && vitest run --config tests/vitest.config.js",
    "test:rust": "cargo test --workspace --locked --features codexhost-shim/test-utils",
    "test": "npm run test:typescript && npm run test:rust",
    "format": "prettier --write . && cargo fmt --all",
    "debug:build": "bash tools/fork/with-toolchain.sh node tools/fork/build.mjs --debug",
    "debug:start": "bash tools/fork/with-toolchain.sh node tools/fork/debug.mjs start",
    "debug:restart": "bash tools/fork/with-toolchain.sh node tools/fork/debug.mjs restart",
    "debug:stop": "bash tools/fork/with-toolchain.sh node tools/fork/debug.mjs stop",
    "debug:status": "bash tools/fork/with-toolchain.sh node tools/fork/debug.mjs status",
    "debug": "npm run debug:build && npm run debug:restart"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@anthropic-ai/sdk": "0.115.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "diff": "8.0.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
