{
  "name": "claude-in-codex",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=22.19.0 <23.0.0 || >=24.0.0 <25.0.0"
  },
  "workspaces": [
    "packages/*",
    "packages/adapters/*"
  ],
  "prettier": {
    "arrowParens": "always",
    "endOfLine": "lf",
    "printWidth": 100,
    "proseWrap": "preserve",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "scripts": {
    "bootstrap": "node tools/toolchain/bootstrap.mjs",
    "build:typescript": "tsc -b && npm run build:plugins",
    "build:plugins": "node scripts/release/harness-plugins.mjs --output packages/host-runtime/dist/plugins",
    "build:rust": "cargo build --locked --package claude-in-codex-platform --package claude-in-codex-shim",
    "typecheck": "tsc -b --pretty false && tsc -p tests/tsconfig.json --pretty false",
    "test:typescript": "npm run build:typescript && vitest run --config tests/vitest.config.js",
    "test:unit": "vitest run --config tests/vitest.config.js --project unit",
    "test:integration": "vitest run --config tests/vitest.config.js --project integration",
    "test:watch": "vitest --config tests/vitest.config.js --project unit",
    "test:coverage": "npm run build:typescript && vitest run --config tests/vitest.config.js --coverage",
    "test": "npm run test:typescript && npm run test:rust",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && bash tools/toolchain/with-toolchain.sh cargo fmt --all --check",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test:rust": "bash tools/toolchain/with-toolchain.sh cargo test --workspace --features claude-in-codex-shim/test-utils",
    "app:build": "npm run build:typescript && node tools/app/build.mjs",
    "app:install": "npm run app:build && node tools/app/install.mjs",
    "app:dmg": "npm run app:build && node tools/app/dmg.mjs",
    "release:app": "npm run build:typescript && node tools/app/release.mjs",
    "release:npm": "node scripts/release/prepare-npm.mjs",
    "release:npm:meta": "node scripts/release/prepare-npm-meta.mjs",
    "release:npm:publish": "node scripts/release/publish-npm.mjs",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.246",
    "@anthropic-ai/sdk": "0.115.0",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "diff": "8.0.2",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "lefthook": "2.1.14",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
